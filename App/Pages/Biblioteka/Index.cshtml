@page
@using App.Infrastructure.Enums
@model App.Pages.Biblioteka.IndexModel
@{
    ViewData["Title"] = "Biblioteka";
}

<h1>Biblioteka wiedzy</h1>
<p class="text-muted">
    Innowacje społeczne, dobre praktyki, raporty, poradniki, Canvy i materiały edukacyjne.
    Każdy użytkownik może zaproponować nowy materiał — publikacja po weryfikacji ROPS.
</p>

<form method="get" class="row g-2 mb-4" role="search">
    <div class="col-md-5">
        <label for="szuk" class="form-label visually-hidden">Szukaj</label>
        <input id="szuk" asp-for="Szukaj" class="form-control" placeholder="Szukaj po tytule, opisie, tagach" />
    </div>
    <div class="col-md-3">
        <label for="typ" class="form-label visually-hidden">Typ</label>
        <select id="typ" asp-for="FiltrTyp" class="form-select">
            <option value="">Dowolny typ</option>
            @foreach (var t in Enum.GetValues<TypMaterialu>())
            {
                <option value="@t">@App.Pages.Biblioteka.IndexModel.NazwaTypu(t)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="obszar" class="form-label visually-hidden">Obszar</label>
        <select id="obszar" asp-for="FiltrObszar" class="form-select">
            <option value="">Dowolny obszar</option>
            @foreach (var o in Model.DostepneObszary) { <option value="@o">@o</option> }
        </select>
    </div>
    <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-primary">Filtruj</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="mb-0 text-muted small">Znaleziono @Model.Materialy.Count materiałów.</p>
    <a class="btn btn-outline-primary btn-sm" asp-page="/Biblioteka/Dodaj">+ Zaproponuj materiał</a>
</div>

@if (Model.Materialy.Count == 0)
{
    <div class="alert alert-info">Brak materiałów spełniających kryteria.</div>
}
else
{
    <div class="row g-3">
        @foreach (var l in Model.Materialy)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100">
                    <div class="card-body">
                        <p class="small mb-1">
                            <span class="badge bg-light text-dark border">@App.Pages.Biblioteka.IndexModel.NazwaTypu(l.Typ)</span>
                        </p>
                        <h2 class="h6"><a asp-page="/Biblioteka/Szczegoly" asp-route-id="@l.Id">@l.Tytul</a></h2>
                        <p class="small text-muted mb-2">@l.KrotkiOpis</p>
                        <p class="small mb-0">
                            @foreach (var t in (l.Tagi ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(5))
                            {
                                <span class="badge bg-light text-dark border me-1">@t</span>
                            }
                        </p>
                    </div>
                    <div class="card-footer small text-muted">
                        @if (l.AutorPubliczny && !string.IsNullOrWhiteSpace(l.AutorNazwa)) { @l.AutorNazwa } else { <em>anonimowo</em> }
                        @if (l.OpublikowanoUtc is not null) { <span> · @l.OpublikowanoUtc.Value.ToLocalTime():yyyy-MM-dd</span> }
                    </div>
                </article>
            </div>
        }
    </div>
}
