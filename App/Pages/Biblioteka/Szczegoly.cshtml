@page
@model App.Pages.Biblioteka.SzczegolyModel
@{
    ViewData["Title"] = Model.Material.Tytul;
    var m = Model.Material;
}

<nav aria-label="okruszki" class="mb-2">
    <a asp-page="/Biblioteka/Index" class="small">← Biblioteka</a>
</nav>

@if (TempData["Komunikat"] is string msg)
{
    <div class="alert alert-success" role="status" aria-live="polite">@msg</div>
}

<article>
    <header class="mb-3">
        <p class="small text-muted mb-1">
            <span class="badge bg-light text-dark border">@App.Pages.Biblioteka.IndexModel.NazwaTypu(m.Typ)</span>
            @if (m.Status != App.Infrastructure.Enums.StatusMaterialu.Opublikowany)
            {
                <span class="badge bg-warning text-dark ms-1">@m.Status</span>
            }
        </p>
        <h1>@m.Tytul</h1>
        <p class="text-muted small">
            @if (m.AutorPubliczny && !string.IsNullOrWhiteSpace(m.AutorNazwa)) { @("Autor: " + m.AutorNazwa) } else { <em>Autor anonimowy</em> }
            @if (!string.IsNullOrWhiteSpace(m.Zrodlo)) { <span> · Źródło: @m.Zrodlo</span> }
            @if (m.OpublikowanoUtc is not null) { <span> · Opublikowano @m.OpublikowanoUtc.Value.ToLocalTime():yyyy-MM-dd</span> }
        </p>
    </header>

    <p class="lead">@m.KrotkiOpis</p>

    @if (!string.IsNullOrWhiteSpace(m.OpisPelny))
    {
        <section class="my-3">
            <p style="white-space:pre-line">@m.OpisPelny</p>
        </section>
    }

    <dl class="row small">
        @if (!string.IsNullOrWhiteSpace(m.GrupaOdbiorcow)) { <dt class="col-sm-3">Grupa odbiorców</dt><dd class="col-sm-9">@m.GrupaOdbiorcow</dd> }
        @if (!string.IsNullOrWhiteSpace(m.ZasiegGeograficzny)) { <dt class="col-sm-3">Zasięg</dt><dd class="col-sm-9">@m.ZasiegGeograficzny</dd> }
        @if (!string.IsNullOrWhiteSpace(m.Obszary))
        {
            <dt class="col-sm-3">Obszary</dt>
            <dd class="col-sm-9">
                @foreach (var o in m.Obszary.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="badge bg-light text-dark border me-1">@o</span>
                }
            </dd>
        }
        @if (!string.IsNullOrWhiteSpace(m.Tagi))
        {
            <dt class="col-sm-3">Tagi</dt>
            <dd class="col-sm-9">
                @foreach (var t in m.Tagi.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="badge bg-light text-dark border me-1">@t</span>
                }
            </dd>
        }
        @if (!string.IsNullOrWhiteSpace(m.Licencja)) { <dt class="col-sm-3">Licencja</dt><dd class="col-sm-9">@m.Licencja</dd> }
    </dl>

    @if (!string.IsNullOrWhiteSpace(m.Link))
    {
        <p>
            <a class="btn btn-primary" href="@m.Link" target="_blank" rel="noopener noreferrer">Otwórz zewnętrzne źródło</a>
        </p>
    }
</article>

<section class="my-5" aria-labelledby="prop">
    <h2 id="prop" class="h5">Zaproponuj zmianę w tym materiale</h2>
    <p class="small text-muted">Pracownik ROPS porówna wersje i zdecyduje, czy wprowadzić poprawkę. Autor nie dowiaduje się o Twojej propozycji bez decyzji ROPS.</p>

    <details>
        <summary class="btn btn-sm btn-outline-primary">Zaproponuj poprawkę</summary>
        <form method="post" asp-page-handler="Propozycja" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="Propozycja.NowyTytul" class="form-label">Nowy tytuł (opcjonalnie)</label>
                    <input asp-for="Propozycja.NowyTytul" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Propozycja.NoweTagi" class="form-label">Nowe tagi (po przecinku)</label>
                    <input asp-for="Propozycja.NoweTagi" class="form-control" maxlength="500" />
                </div>
                <div class="col-12">
                    <label asp-for="Propozycja.NowyKrotkiOpis" class="form-label">Nowy krótki opis</label>
                    <textarea asp-for="Propozycja.NowyKrotkiOpis" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Propozycja.NowyOpisPelny" class="form-label">Nowy opis pełny</label>
                    <textarea asp-for="Propozycja.NowyOpisPelny" class="form-control" rows="4" maxlength="4000"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Propozycja.NowyLink" class="form-label">Nowy link</label>
                    <input asp-for="Propozycja.NowyLink" class="form-control" type="url" maxlength="500" />
                </div>
                <div class="col-12">
                    <label asp-for="Propozycja.Uzasadnienie" class="form-label">Uzasadnienie zmiany (wymagane)</label>
                    <textarea asp-for="Propozycja.Uzasadnienie" class="form-control" rows="3" required maxlength="1000"></textarea>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Wyślij propozycję</button>
        </form>
    </details>
</section>
