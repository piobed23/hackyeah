@page
@model App.Pages.Wnioski.EdycjaModel
@{
    ViewData["Title"] = $"Wniosek: {Model.Wniosek.TytulProjektu}";
    var typ = Model.Wniosek.TypWnioskodawcy;
}

<h1>Wniosek: @Model.Wniosek.TytulProjektu</h1>
<p class="text-muted small">
    Nabór: @Model.Nabor?.Nazwa · Status: @Model.Wniosek.Status
    · Formularz zgodny z zał. nr 3 Ogłoszenia (FERS 5.1, Inkubator Włączenia Społecznego 2.0)
</p>

@await Html.PartialAsync("_WniosekMenu", (Model.Id, "opis"))

@if (!string.IsNullOrEmpty(Model.Komunikat))
{
    <div class="alert alert-success py-2" role="status" aria-live="polite">@Model.Komunikat</div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <section id="wnioskodawca" aria-labelledby="h-wn" class="mb-4">
        <h2 id="h-wn" class="h5">1-2. Wnioskodawca</h2>

        <div class="mb-3">
            <label asp-for="Wniosek.TytulProjektu" class="form-label">1. Tytuł innowacji</label>
            <input asp-for="Wniosek.TytulProjektu" class="form-control" required maxlength="200" aria-describedby="help-tyt" />
            <div id="help-tyt" class="form-text">Zastanów się nad tytułem, by był krótki i kojarzący się z przedmiotem innowacji.</div>
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">2. Typ wnioskodawcy</legend>
            @foreach (var t in Enum.GetValues<TypWnioskodawcy>())
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Wniosek.TypWnioskodawcy" id="tw-@t" value="@t" @(typ == t ? "checked" : "") />
                    <label class="form-check-label" for="tw-@t">@(t switch {
                        TypWnioskodawcy.OsobaFizyczna => "Osoba fizyczna",
                        TypWnioskodawcy.Podmiot => "Podmiot",
                        TypWnioskodawcy.GrupaNieformalna => "Grupa nieformalna",
                        _ => t.ToString()
                    })</label>
                </div>
            }
        </fieldset>

        <div class="row g-2">
            <div class="col-md-6">
                <label asp-for="Wniosek.Imie" class="form-label">Imię (reprezentanta)</label>
                <input asp-for="Wniosek.Imie" class="form-control" maxlength="80" />
            </div>
            <div class="col-md-6">
                <label asp-for="Wniosek.Nazwisko" class="form-label">Nazwisko (reprezentanta)</label>
                <input asp-for="Wniosek.Nazwisko" class="form-control" maxlength="80" />
            </div>
            <div class="col-md-8">
                <label asp-for="Wniosek.AdresKorespondencyjny" class="form-label">Adres (ulica, nr budynku, nr lokalu)</label>
                <input asp-for="Wniosek.AdresKorespondencyjny" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-2">
                <label asp-for="Wniosek.KodPocztowy" class="form-label">Kod pocztowy</label>
                <input asp-for="Wniosek.KodPocztowy" class="form-control" maxlength="10" pattern="\d{2}-\d{3}" placeholder="00-000" />
            </div>
            <div class="col-md-2">
                <label asp-for="Wniosek.Miejscowosc" class="form-label">Miejscowość</label>
                <input asp-for="Wniosek.Miejscowosc" class="form-control" maxlength="80" />
            </div>
            <div class="col-md-6">
                <label asp-for="Wniosek.Telefon" class="form-label">Telefon</label>
                <input asp-for="Wniosek.Telefon" class="form-control" maxlength="30" type="tel" />
            </div>
            <div class="col-md-6">
                <label asp-for="Wniosek.Email" class="form-label">E-mail</label>
                <input asp-for="Wniosek.Email" class="form-control" maxlength="160" type="email" />
            </div>
        </div>

        <details class="mt-3" @(typ == TypWnioskodawcy.Podmiot ? "open" : "")>
            <summary>Dane podmiotu (wypełnij, jeśli wnioskujesz jako podmiot)</summary>
            <div class="row g-2 mt-2">
                <div class="col-md-6">
                    <label asp-for="Wniosek.NazwaPodmiotu" class="form-label">Nazwa podmiotu</label>
                    <input asp-for="Wniosek.NazwaPodmiotu" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Wniosek.KRS" class="form-label">KRS</label>
                    <input asp-for="Wniosek.KRS" class="form-control" maxlength="30" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Wniosek.REGON" class="form-label">REGON</label>
                    <input asp-for="Wniosek.REGON" class="form-control" maxlength="30" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Wniosek.NIP" class="form-label">NIP</label>
                    <input asp-for="Wniosek.NIP" class="form-control" maxlength="30" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Wniosek.OsobaReprezentujaca" class="form-label">Osoba upoważniona (imię i nazwisko)</label>
                    <input asp-for="Wniosek.OsobaReprezentujaca" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Wniosek.FunkcjaReprezentujacego" class="form-label">Funkcja</label>
                    <input asp-for="Wniosek.FunkcjaReprezentujacego" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Wniosek.OsobaKontaktowa" class="form-label">Osoba do kontaktów roboczych</label>
                    <input asp-for="Wniosek.OsobaKontaktowa" class="form-control" maxlength="200" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Wniosek.TelefonKontaktowy" class="form-label">Telefon do kontaktu</label>
                    <input asp-for="Wniosek.TelefonKontaktowy" class="form-control" maxlength="30" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Wniosek.EmailKontaktowy" class="form-label">E-mail do kontaktu</label>
                    <input asp-for="Wniosek.EmailKontaktowy" class="form-control" maxlength="160" type="email" />
                </div>
            </div>
        </details>

        <details class="mt-3" @(typ == TypWnioskodawcy.GrupaNieformalna ? "open" : "")>
            <summary>Partnerzy w grupie nieformalnej (do 5)</summary>
            <div class="mt-2">
                <label asp-for="Wniosek.PartnerzyJson" class="form-label">Partnerzy (JSON lub lista)</label>
                <textarea asp-for="Wniosek.PartnerzyJson" class="form-control" rows="4" placeholder='Opisz 1-5 partnerów: imię/nazwa, dane kontaktowe. Każdy od nowej linii.'></textarea>
            </div>
        </details>
    </section>

    <section id="opis" aria-labelledby="h-opis" class="mb-4">
        <h2 id="h-opis" class="h5">3-8, 11. Opis merytoryczny</h2>

        <div class="mb-3">
            <label asp-for="Wniosek.Streszczenie" class="form-label">Streszczenie (wewnętrzne)</label>
            <textarea asp-for="Wniosek.Streszczenie" class="form-control" rows="2" maxlength="1000"></textarea>
            <div class="form-text">Krótkie streszczenie do widoku „Moje" i podglądu — nie część formularza aplikacyjnego.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.OpisInnowacji" class="form-label">3. Opis innowacji</label>
            <textarea asp-for="Wniosek.OpisInnowacji" class="form-control" rows="5" maxlength="4000" aria-describedby="h-3"></textarea>
            <div id="h-3" class="form-text">Na czym polega innowacja? Jaki jest jej charakter (produkt, aplikacja, model pracy, rozwiązanie technologiczne)? Jak realizuje cel włączenia społecznego i wpisuje się w deinstytucjonalizację?</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.Innowacyjnosc" class="form-label">4. Innowacyjność rozwiązania</label>
            <textarea asp-for="Wniosek.Innowacyjnosc" class="form-control" rows="5" maxlength="4000" aria-describedby="h-4"></textarea>
            <div id="h-4" class="form-text">Czy podobne rozwiązania są stosowane w Polsce / na świecie? W czym nowa wartość? Czym projekt wyróżnia się?</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.DiagnozaProblemu" class="form-label">5. Diagnoza problemu</label>
            <textarea asp-for="Wniosek.DiagnozaProblemu" class="form-control" rows="5" maxlength="4000" aria-describedby="h-5"></textarea>
            <div id="h-5" class="form-text">Dane statystyczne, raporty, badania. Zgodność z Mapą Wyzwań Społecznych — jeśli tak, wskaż temat niżej.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.MapaWyzwanTemat" class="form-label">Temat z Mapy Wyzwań Społecznych (opcjonalnie)</label>
            <input asp-for="Wniosek.MapaWyzwanTemat" class="form-control" maxlength="200" />
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.OpisOdbiorcow" class="form-label">6. Opis odbiorców innowacji</label>
            <textarea asp-for="Wniosek.OpisOdbiorcow" class="form-control" rows="5" maxlength="4000" aria-describedby="h-6"></textarea>
            <div id="h-6" class="form-text">Do kogo jest skierowana? Co tę grupę wyróżnia? Potrzeby? Powód wykluczenia / zagrożenia wykluczeniem?</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.ZmianaJakaWprowadza" class="form-label">7. Zmiana jaką wprowadza innowacja</label>
            <textarea asp-for="Wniosek.ZmianaJakaWprowadza" class="form-control" rows="5" maxlength="4000" aria-describedby="h-7"></textarea>
            <div id="h-7" class="form-text">Jak wpłynie na problem? Co zmieni w życiu odbiorców? Jak przeciwdziała procesowi wykluczenia?</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.WizjaPrzyszlosci" class="form-label">8. Wizja przyszłości innowacji</label>
            <textarea asp-for="Wniosek.WizjaPrzyszlosci" class="form-control" rows="5" maxlength="4000" aria-describedby="h-8"></textarea>
            <div id="h-8" class="form-text">Potencjał skalowania, zastosowanie dla innych grup, inne konteksty. Łatwość wdrożenia.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.WnioskowanaKwotaGrantu" class="form-label">10. Wnioskowana kwota grantu (PLN)</label>
            <input asp-for="Wniosek.WnioskowanaKwotaGrantu" type="number" step="0.01" min="0" class="form-control" aria-describedby="h-10" />
            <div id="h-10" class="form-text">Całościowa wnioskowana kwota — powinna odpowiadać sumie kosztów częściowych w planie działania.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Wniosek.ZespolDoswiadczenie" class="form-label">11. Zespół projektowy i jego doświadczenie</label>
            <textarea asp-for="Wniosek.ZespolDoswiadczenie" class="form-control" rows="5" maxlength="4000" aria-describedby="h-11"></textarea>
            <div id="h-11" class="form-text">Kto odpowiada za zadania? Jakie doświadczenie w pracy z odbiorcami i we wdrażaniu innowacji społecznych?</div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Zapisz</button>
        <a class="btn btn-outline-secondary" asp-page="/Wnioski/Harmonogram" asp-route-id="@Model.Id">Przejdź do planu działania</a>
        <a class="btn btn-outline-secondary" asp-page="/Wnioski/Budzet" asp-route-id="@Model.Id">Przejdź do budżetu</a>
    </div>
</form>
