@page
@model App.Pages.Rops.PodgladTesterowModel
@{
    ViewData["Title"] = "Przegląd sesji testowych";
}

<h1>Przegląd sesji testowych</h1>
<p class="text-muted">
    Przegląd wszystkich sesji testowych w systemie. Dla sesji w statusie „Zakończone" możesz zatwierdzić innowację jako <strong>sprawdzoną</strong>.
</p>

@if (TempData["Blad"] is string blad)
{
    <div class="alert alert-warning" role="alert">@blad</div>
}

@if (Model.Sesje.Count == 0)
{
    <div class="alert alert-info">Brak sesji testowych w systemie.</div>
}
else
{
    @foreach (var s in Model.Sesje)
    {
        var opinie = s.Zgloszenia.Where(z => z.Opinia is not null).Select(z => z.Opinia!).ToList();
        <article class="card my-3">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <h2 class="h6 mb-1">
                            @s.Idea.Karta?.Tytul
                            <span class="badge bg-light text-dark border ms-2">@s.Status</span>
                        </h2>
                        <p class="small text-muted mb-0">
                            Autor: @s.Idea.Autor.Imie @s.Idea.Autor.Nazwisko
                            · @(s.Zdalny ? "zdalny" : "stacjonarny")
                            · utworzono @s.UtworzonoUtc.ToLocalTime():yyyy-MM-dd
                        </p>
                    </div>
                    <div class="text-end small">
                        <p class="mb-0">Zgłoszeń: @s.Zgloszenia.Count</p>
                        <p class="mb-0">Opinii: @opinie.Count</p>
                        @if (opinie.Count > 0) { <p class="mb-0">Śr. ocena: @opinie.Average(o => o.OcenaOgolna).ToString("0.#")/5</p> }
                    </div>
                </div>

                @if (opinie.Any(o => !string.IsNullOrWhiteSpace(o.BariereDostepnosci)))
                {
                    <div class="alert alert-warning mt-2 py-1 small">
                        <strong>Zgłoszone bariery dostępności:</strong>
                        @string.Join(" · ", opinie.Where(o => !string.IsNullOrWhiteSpace(o.BariereDostepnosci)).Select(o => o.BariereDostepnosci))
                    </div>
                }

                <div class="mt-2 d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Publiczne/Karta" asp-route-id="@s.IdeaId">Publiczna karta innowacji</a>
                    @if (s.Status == App.Infrastructure.Enums.StatusSesjiTestowej.Zakonczone)
                    {
                        <form method="post" asp-page-handler="Zatwierdz" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sesjaId" value="@s.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Zatwierdź jako sprawdzoną innowację</button>
                        </form>
                    }
                </div>
            </div>
        </article>
    }
}
